{
  "name": "dsh-bilingual",
  "version": "0.1.6",
  "type": "module",
  "description": "DSH 桌面端中英逐段翻译 / 双语对照：开启后，助手回复的每一段原文下方自动追加另一种语言（中文→英文 / 英文→中文）。Paragraph-by-paragraph translation and bilingual display for the DeepSeek Harness desktop app.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bilingual",
    "translation",
    "translate",
    "i18n",
    "翻译",
    "双语",
    "中英对照"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hemuchuan/dsh-bilingual.git"
  },
  "homepage": "https://github.com/Hemuchuan/dsh-bilingual#readme",
  "bugs": {
    "url": "https://github.com/Hemuchuan/dsh-bilingual/issues"
  },
  "author": "Hemuchuan",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
